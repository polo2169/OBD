APP_NAME=Diagbox++ OpenDiag PSA
TRANSPORT=virtual
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=921600
# Passerelle TCP créée par le profil esp32-waveshare-wifi-readonly.
ESP32_WIFI_HOST=192.168.4.1
ESP32_WIFI_PORT=35000
ESP32_WIFI_RECONNECT_INTERVAL=0.5
CAN_CHANNEL=vcan0
CAN_INTERFACE=socketcan
# Autorise le backend a emettre des trames CAN sur un transport reel.
# Laisser a false pour les captures passives.
CAN_TX_ENABLED=false
# Filtre applicatif UDS : bloque les services d'ecriture et de programmation.
READ_ONLY=true
DIAGNOSTIC_TIMEOUT=1.0
# Lecture UDS 0x19 des défauts pendant l'autoscan.
READ_DTCS=true
# Journal complet JSONL : CAN, ISO-TP, UDS, NRC et télémétrie ESP32.
DEBUG_SESSIONS_ENABLED=true
TRACE_CAN_FRAMES=true
TRACE_MAX_EVENTS=250000
# Complète une capture CAN par les seuls PIDs Mode 01 listés dans le profil.
# Exige aussi CAN_TX_ENABLED=true et une allowlist firmware compatible.
LIVE_OBD_ENABLED=true
ESP32_HANDSHAKE_TIMEOUT=3.0
# Maintenance destructive : toujours laisser ces options à false pendant
# l'inventaire et le premier essai sur véhicule.
DTC_CLEAR_ENABLED=false
SAFETY_ECU_CLEAR_ENABLED=false
# Diagnostic PSA constructeur. Les lectures 0x22 restent filtrées et tracées.
PSA_ADVANCED_ENABLED=true
# Double opt-in séparé pour SecurityAccess et les actionneurs NAC nommés.
# Ils exigent aussi READ_ONLY=false, CAN_TX_ENABLED=true et le firmware PSA lab.
PSA_SECURITY_ACCESS_ENABLED=false
PSA_ACTUATOR_ENABLED=false
PSA_ACTUATOR_MAX_DURATION_MS=3000
DATABASE_DIR=../database
SESSION_DIR=../data/sessions
DIAGNOSTIC_TRACE_IMPORT_DIR=../data/diagbox_imports
SENSOR_OVERRIDES_FILE=../data/sensor_overrides.json
VEHICLE_PROFILE=peugeot_308_t9_2018
# Enrichit uniquement les captures reçues avec le DBC PSA MIT de commaai/opendbc.
# Cette option ne permet aucune émission CAN.
OPENDBC_ENABLED=true
