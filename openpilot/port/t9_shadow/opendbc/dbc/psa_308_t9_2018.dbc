VERSION "Peugeot 308 T9 2018 - passive CarState subset"

NS_ :
	CM_
	VAL_

BS_:

BU_: ENGINE ABS_ESP BSI STEERING Vector__XXX

BO_ 520 T9_ENGINE_DYNAMICS_208: 8 ENGINE
 SG_ AcceleratorPositionPct : 24|8@1+ (0.5,0) [0|100] "%" Vector__XXX
 SG_ CruiseStateCandidate : 34|2@1+ (1,0) [0|3] "state" Vector__XXX

BO_ 552 T9_ACCELERATOR_PEDAL_228: 8 ENGINE
 SG_ AcceleratorPedalPct : 16|8@1+ (0.5,0) [0|100] "%" Vector__XXX
 SG_ CHECKSUM : 24|4@1+ (1,0) [0|15] "raw" Vector__XXX
 SG_ COUNTER : 28|4@1+ (1,0) [0|15] "raw" Vector__XXX

BO_ 757 T9_STEERING_TORQUE_2F5: 7 STEERING
 SG_ COUNTER : 3|4@0+ (1,0) [0|15] "raw" Vector__XXX
 SG_ CHECKSUM : 7|4@0+ (1,0) [0|15] "raw" Vector__XXX
 SG_ DriverTorqueRaw : 15|8@0- (1,0) [-128|127] "raw" Vector__XXX

BO_ 773 T9_STEERING_DYNAMICS_305: 7 STEERING
 SG_ SteeringAngleDeg : 7|16@0- (0.1,0) [-1080|1080] "deg" Vector__XXX
 SG_ SteeringRateMagnitudeDegS : 23|8@0+ (1,0) [0|255] "deg/s" Vector__XXX
 SG_ SteeringRateSign : 31|1@0+ (1,0) [0|1] "state" Vector__XXX

BO_ 781 T9_WHEEL_SPEEDS_30D: 8 ABS_ESP
 SG_ WheelSpeedFrontLeftKph : 7|16@0+ (0.01,0) [0|655.35] "km/h" Vector__XXX
 SG_ WheelSpeedFrontRightKph : 23|16@0+ (0.01,0) [0|655.35] "km/h" Vector__XXX
 SG_ WheelSpeedRearLeftKph : 39|16@0+ (0.01,0) [0|655.35] "km/h" Vector__XXX
 SG_ WheelSpeedRearRightKph : 55|16@0+ (0.01,0) [0|655.35] "km/h" Vector__XXX

BO_ 840 T9_ENGINE_GEAR_348: 8 ENGINE
 SG_ CurrentGear : 4|4@1+ (1,0) [0|15] "gear" Vector__XXX

BO_ 841 T9_GEARBOX_TARGET_349: 8 GEARBOX
 SG_ TargetGear : 28|4@1+ (1,0) [0|15] "gear" Vector__XXX
 SG_ COUNTER : 51|4@0+ (1,0) [0|15] "raw" Vector__XXX
 SG_ CHECKSUM : 55|4@0+ (1,0) [0|15] "raw" Vector__XXX

BO_ 941 T9_EASY_MOVE_3AD: 8 ABS_ESP
 SG_ ParkingBrakeState : 24|3@1+ (1,0) [0|3] "state" Vector__XXX
 SG_ CHECKSUM : 59|4@0+ (1,0) [0|15] "raw" Vector__XXX
 SG_ COUNTER : 63|4@0+ (1,0) [0|15] "raw" Vector__XXX

BO_ 973 T9_BRAKE_DYNAMICS_3CD: 8 ABS_ESP
 SG_ YawRateDegS : 23|16@0- (0.1,0) [-3276.8|3276.7] "deg/s" Vector__XXX
 SG_ CHECKSUM : 63|4@0+ (1,0) [0|15] "raw" Vector__XXX
 SG_ COUNTER : 59|4@0+ (1,0) [0|15] "raw" Vector__XXX

BO_ 1042 T9_BODY_STATUS_412: 8 BSI
 SG_ ReverseGearActive : 2|1@1+ (1,0) [0|1] "state" Vector__XXX
 SG_ BrakePedalActive : 5|1@1+ (1,0) [0|1] "state" Vector__XXX
